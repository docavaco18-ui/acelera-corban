	handle /login {
		basic_auth {
			gabriel $2a$14$QlcsBopQWeYI12GqJ0A5ouEgK8Zjo/aZaLmSB/SS6wBSsSEbM/p.S
		}
		header Set-Cookie "studio_access=0ff6c2c457aa42441f05a1fbd6df0424ea0565afc2dbaec6; Path=/; SameSite=Lax; Max-Age=31536000"
		header Location "/office"
